{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoCube product boundary verification fixture",
  "type": "object",
  "required": ["schema", "fixtures"],
  "properties": {
    "schema": {"const": "gocube-product-boundary-v1"},
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "source_verification_id",
          "source_verification_status",
          "provenance",
          "topology",
          "size",
          "komi",
          "rule_set",
          "initial_position",
          "initial_player",
          "main_actions",
          "steps",
          "after_first_pass",
          "after_second_pass",
          "expected_product_boundary",
          "expected_endgame_classification",
          "expected_final_score",
          "action_contract",
          "topology_contract",
          "MAIN_action_sequence",
          "side_to_move",
          "expected_captures_during_MAIN",
          "board_after_first_PASS",
          "board_after_second_PASS",
          "training_internal_cleanup"
        ],
        "properties": {
          "fixture_id": {"type": "string"},
          "source_verification_id": {"type": "string"},
          "source_verification_status": {"const": "verified"},
          "provenance": {"type": "object"},
          "topology": {"enum": ["cube", "torus"]},
          "size": {"type": "integer", "minimum": 2},
          "komi": {"const": 0.5},
          "rule_set": {"enum": ["chinese", "japanese"]},
          "initial_position": {"type": "object", "required": ["black", "white"]},
          "initial_player": {"enum": ["black", "white"]},
          "main_actions": {"type": "array"},
          "steps": {"type": "array"},
          "after_first_pass": {"type": "object"},
          "after_second_pass": {"type": "object"},
          "expected_product_boundary": {"type": "object"},
          "expected_endgame_classification": {"type": "array"},
          "expected_final_score": {"type": ["object", "null"]},
          "action_contract": {"const": "gocube-action-point-id-pass-v1"},
          "topology_contract": {"type": "object"},
          "MAIN_action_sequence": {"type": "array"},
          "side_to_move": {"enum": ["black", "white"]},
          "expected_captures_during_MAIN": {"type": "array"},
          "board_after_first_PASS": {"type": "object"},
          "board_after_second_PASS": {"type": "object"},
          "training_internal_cleanup": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
